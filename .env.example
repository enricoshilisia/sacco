# Copy this file to .env and fill in real values. Never commit .env.

# --- Postgres ---
POSTGRES_DB=sacco
POSTGRES_USER=sacco
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=sacco_minio
MINIO_ROOT_PASSWORD=change-me-locally
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=sacco-documents

# --- Django ---
DJANGO_SECRET_KEY=change-me-generate-a-real-one
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- SMS providers (fill in real credentials per environment; never commit) ---
# Kenya primary
HOSTPINNACLE_API_KEY=
HOSTPINNACLE_API_SECRET=
HOSTPINNACLE_SENDER_ID=
# Tanzania primary
BEEM_API_KEY=
BEEM_SECRET_KEY=
BEEM_SENDER_ID=
# Backup for both countries
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# --- Payment providers ---
# Kenya - Daraja (M-Pesa)
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_ENV=sandbox
# Tanzania - Selcom
SELCOM_API_KEY=
SELCOM_API_SECRET=
SELCOM_VENDOR_ID=
SELCOM_ENV=sandbox

# --- Firebase Cloud Messaging (push notifications) ---
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON_PATH=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- WebAuthn (biometric auth) ---
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=SACCO Platform
WEBAUTHN_ORIGIN=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
