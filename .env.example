# Copy this file to .env and fill in real values. Never commit .env.

# --- Postgres ---
POSTGRES_DB=sacco
POSTGRES_USER=sacco
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=sacco_minio
MINIO_ROOT_PASSWORD=change-me-locally
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=sacco-documents
MINIO_ENDPOINT_URL=http://localhost:9000
# Set this to a publicly reachable host:port (e.g. your nip.io address)
# once you need uploaded logos/photos to load in a browser that isn't on
# this same machine - see core/storage.py. Leave blank for pure-local dev.
MINIO_PUBLIC_ENDPOINT_URL=

# --- Django ---
DJANGO_SECRET_KEY=change-me-generate-a-real-one
DJANGO_DEBUG=True
# Leading-dot entries are wildcard subdomain matches (Django's own
# ALLOWED_HOSTS behavior) - required so self-service SACCO signup doesn't
# need a manual settings edit + restart per new tenant.
#
# - Local dev (browser on this same machine): .localhost is enough.
# - Remote/cloud access without a real domain yet: use nip.io, a free
#   wildcard-DNS-over-IP service - "<anything>.<your-server-ip>.nip.io"
#   publicly resolves to your-server-ip. e.g. for IP 20.56.34.194:
#     DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.localhost,20.56.34.194,.20.56.34.194.nip.io
#     TENANT_BASE_DOMAIN=20.56.34.194.nip.io
# - Real production: ".yourplatformdomain.com" with real wildcard DNS.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.localhost
DJANGO_SETTINGS_MODULE=config.settings

# Base domain new tenants are provisioned under: <slug>.<this>.
TENANT_BASE_DOMAIN=localhost

# Origins allowed to call the API via CORS - must include wherever the
# frontend is actually served from (add your nip.io/real domain's :3000
# origin here too if using one).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- SMS providers (fill in real credentials per environment; never commit) ---
# Kenya primary
HOSTPINNACLE_API_KEY=
HOSTPINNACLE_API_SECRET=
HOSTPINNACLE_SENDER_ID=
# Tanzania primary
BEEM_API_KEY=
BEEM_SECRET_KEY=
BEEM_SENDER_ID=
# Backup for both countries
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# --- Payment providers ---
# Kenya - Daraja (M-Pesa)
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_ENV=sandbox
# Tanzania - Selcom
SELCOM_API_KEY=
SELCOM_API_SECRET=
SELCOM_VENDOR_ID=
SELCOM_ENV=sandbox

# --- Firebase Cloud Messaging (push notifications) ---
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON_PATH=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- WebAuthn (biometric auth) ---
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=SACCO Platform
WEBAUTHN_ORIGIN=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
