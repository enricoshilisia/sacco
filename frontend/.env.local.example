# Copy to .env.local for local dev. Never commit .env.local.

# Left unset by default: the tenant API base is derived at runtime from
# whatever hostname the browser is on (same host, port 8000 or
# NEXT_PUBLIC_API_PORT). Only set this to pin every request to one fixed
# tenant regardless of which hostname you're browsing from.
# NEXT_PUBLIC_API_BASE_URL=http://nairobi.localhost:8000
# NEXT_PUBLIC_API_PORT=8000

# A host that matches no tenant Domain, so the backend falls back to the
# public schema. Used only by /signup-sacco - the tenant doesn't exist yet
# when that request is made. Plain "localhost" works in dev.
NEXT_PUBLIC_PUBLIC_API_BASE_URL=http://localhost:8000

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
